{
  "name": "dink-duel",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "shared",
    "server",
    "web"
  ],
  "scripts": {
    "dev:https": "node scripts/dev-https.mjs",
    "dev": "concurrently -k -n relay,web \"npm run dev -w server\" \"npm run dev -w web\"",
    "build": "npm run build -w web && npm run build -w server",
    "start": "node server/dist/server/src/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check": "npm run typecheck && npm run lint && npm test && npm run build && npm run check:budget",
    "check:budget": "node scripts/check-budget.mjs",
    "art:generate": "tsx scripts/generate-art.ts",
    "art:process": "tsx scripts/select-art.ts && tsx scripts/process-art.ts",
    "art:review": "tsx scripts/review-art.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@playwright/test": "^1.56.1",
    "@types/node": "^24.10.0",
    "concurrently": "^9.2.1",
    "eslint": "^9.39.0",
    "prettier": "^3.9.10",
    "sharp": "^0.35.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.0",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=22"
  }
}
