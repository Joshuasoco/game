PORT=3001
NODE_ENV=production
# Comma-separated public HTTPS origins; omit for same-origin requests.
ALLOWED_ORIGINS=
# Optional build-time image generation only; never use a VITE_ prefix.
# Set OPENAI_API_KEY in your shell or secret manager, not in tracked files.
OPENAI_IMAGE_MODEL=gpt-image-2.5-sunburst
